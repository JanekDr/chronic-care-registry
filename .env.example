# Dokumentacja zmiennych; Django nie wczytuje automatycznie tego pliku.
# Ustaw SECRET_KEY w środowisku procesu (instrukcja w README.md).
SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Opcjonalnie: bezwzględna ścieżka SQLite; domyślnie db.sqlite3 w katalogu projektu.
DATABASE_PATH=

# Tylko podczas pierwszego seed_demo; hasła dla nowych kont muszą spełniać
# walidatory Django. Puste wartości są bezpiecznymi przykładami, nie hasłami.
DEMO_ADMIN_PASSWORD=
DEMO_PERSONEL_PASSWORD=

